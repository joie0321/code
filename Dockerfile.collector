FROM node:22-bookworm-slim AS dashboard-build

WORKDIR /build
COPY collector_agent/dashboard_react/package.json collector_agent/dashboard_react/package-lock.json ./
RUN npm ci --include=dev
COPY collector_agent/dashboard_react/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system flowwave \
    && useradd --system --gid flowwave --create-home --home-dir /home/flowwave flowwave

WORKDIR /app
COPY pyproject.toml ./
COPY collector_agent/ ./collector_agent/
RUN python -m pip install --no-cache-dir .
COPY --from=dashboard-build /build/dist ./collector_agent/dashboard_react/dist/
RUN mkdir --parents /var/lib/flowwave \
    && chown -R flowwave:flowwave /app /var/lib/flowwave

USER flowwave
EXPOSE 8443 8502 4739/udp
CMD ["uvicorn", "collector_agent.main:app", "--host", "127.0.0.1", "--port", "8443"]
