APP_ENV=development
DATABASE_URL=sqlite:///./control_plane.db
# Generate a unique value of at least 32 characters. Do not commit a real value.
CONTROL_PLANE_ADMIN_API_KEY=replace-with-a-unique-admin-key-at-least-32-characters
# Development defaults. In production configure HTTPS and a separate read-only dashboard key.
CONTROL_PLANE_DASHBOARD_API_URL=http://127.0.0.1:8100
CONTROL_PLANE_DASHBOARD_API_KEY=
