APP_ENV=development
# Modes: development (SQLite/local testing), oci_vault (OCI production), or
# external (customer-managed PostgreSQL). Bundled PostgreSQL is a later release.
DATABASE_MODE=development
DATABASE_URL=sqlite:///./control_plane.db
# For development-only PostgreSQL testing, inject the password through the process
# environment instead of adding it to DATABASE_URL. Never commit a real value.
# DATABASE_PASSWORD=
#
# OCI production example (no password in this file):
# DATABASE_MODE=oci_vault
# DATABASE_URL=postgresql+psycopg://ocimigration_app@primary.example.postgresql.ap-sydney-1.oci.oraclecloud.com:5432/ocimigration_cp?sslmode=verify-full&sslrootcert=/opt/ocimigration/certs/postgresql-ca.pem
# DATABASE_PASSWORD_SECRET_OCID=ocid1.vaultsecret.oc1..replace-me
#
# Customer external PostgreSQL example (password must be a protected mounted secret):
# DATABASE_MODE=external
# DATABASE_URL=postgresql+psycopg://migration_app@db.customer.internal:5432/migration_control?sslmode=verify-full&sslrootcert=/etc/migration-control/postgresql-ca.pem
# DATABASE_PASSWORD_FILE=/run/secrets/migration_control_database_password
# Local external PostgreSQL test example. The database connection remains TLS-protected;
# only the local dashboard-to-API connection may use HTTP on loopback.
# APP_ENV=development
# DATABASE_MODE=external
# DATABASE_URL=postgresql+psycopg://migration_app@db.customer.internal:5432/migration_control?sslmode=verify-full&sslrootcert=/etc/migration-control/postgresql-ca.pem
# DATABASE_PASSWORD_FILE=/absolute/path/to/test-database-password
# CONTROL_PLANE_DASHBOARD_API_URL=http://127.0.0.1:8100
# Generate a unique value of at least 32 characters. Do not commit a real value.
CONTROL_PLANE_ADMIN_API_KEY=replace-with-a-unique-admin-key-at-least-32-characters
# Development defaults. In production configure HTTPS and a separate read-only dashboard key.
CONTROL_PLANE_DASHBOARD_API_URL=http://127.0.0.1:8100
CONTROL_PLANE_DASHBOARD_API_KEY=

# OCI Container Instance deployment: the Control API and Control UI are separate
# containers in the same Container Instance and use its shared loopback namespace.
# Do not set this for a UI deployed outside that Container Instance; use HTTPS instead.
# APP_ENV=production
# DATABASE_MODE=oci_vault
# CONTROL_PLANE_DASHBOARD_API_URL=http://127.0.0.1:8100
# CONTROL_PLANE_DASHBOARD_API_LOCAL_LOOPBACK=true
# CONTROL_PLANE_ADMIN_API_KEY_SECRET_OCID=ocid1.vaultsecret.oc1..replace-me
# CONTROL_PLANE_DASHBOARD_API_KEY_SECRET_OCID=ocid1.vaultsecret.oc1..replace-me

# Local, non-secret upload sequence state. For this one-time Container Instance
# deployment it is intentionally ephemeral: replacement or image redeployment
# resets it. It contains only collector IDs and sequence counters; never store
# credentials or flow data with it.
AGENT_SEQUENCE_STATE_FILE=collector_agent/collector_sequence_state.json
