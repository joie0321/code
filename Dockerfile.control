FROM node:22-bookworm-slim AS dashboard-build

WORKDIR /build
COPY control_plane/dashboard_react/package.json control_plane/dashboard_react/package-lock.json ./
RUN npm ci --include=dev
COPY control_plane/dashboard_react/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system flowwave \
    && useradd --system --gid flowwave --create-home --home-dir /home/flowwave flowwave

WORKDIR /app
COPY pyproject.toml ./
COPY control_plane/ ./control_plane/
RUN python -m pip install --no-cache-dir .
COPY deploy/certs/postgresql-ca.pem /opt/flowwave/certs/postgresql-ca.pem
COPY deploy/entrypoints/flowwave-control /usr/local/bin/flowwave-control
COPY --from=dashboard-build /build/dist ./control_plane/dashboard_react/dist/
RUN chmod 0555 /usr/local/bin/flowwave-control \
    && chown -R flowwave:flowwave /app /opt/flowwave

USER flowwave
EXPOSE 8100 8503
CMD ["/usr/local/bin/flowwave-control"]
